# Copy to .env and fill in real values:
#   cp .env.example .env

APP_NAME=TrialBridge
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=1
LOG_LEVEL=info

# Local Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql://trialbridge:trialbridge@localhost:5432/trialbridge
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=change-me-api-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Streamlit dashboard + any local frontends
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501

API_V1_PREFIX=/api/v1

# LLM providers (at least one required for matching)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Optional observability
LOGFIRE_WRITE_TOKEN=

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_COOLDOWN_SECONDS=60
